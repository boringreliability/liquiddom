---
const base = import.meta.env.BASE_URL;
const repo = "https://github.com/boringreliability/liquiddom";
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface-muted)] mt-24">
  <div class="container-page py-12 grid gap-10 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2 text-base font-semibold text-[var(--color-ink)]">
        <svg width="22" height="22" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id="footerBrand" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="var(--color-liquid-glow)" />
              <stop offset="100%" stop-color="var(--color-liquid-primary)" />
            </linearGradient>
          </defs>
          <path
            d="M14 3 C 14 3, 23 13, 23 18 A 9 9 0 1 1 5 18 C 5 13, 14 3, 14 3 Z"
            fill="url(#footerBrand)"
          />
        </svg>
        liquiddom
      </div>
      <p class="mt-3 text-sm text-[var(--color-ink-muted)] max-w-xs">
        WASM-driven soft-body physics on real DOM elements.
        Real a11y, real accessibility — no compromises.
      </p>
    </div>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--color-ink-muted)]">Docs</h3>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={`${base}docs/`} class="text-[var(--color-ink)] hover:text-[var(--color-liquid-primary)] transition-colors">Overview</a></li>
        <li><a href={`${base}docs/getting-started/`} class="text-[var(--color-ink)] hover:text-[var(--color-liquid-primary)] transition-colors">Getting Started</a></li>
        <li><a href={`${base}docs/core-concepts/`} class="text-[var(--color-ink)] hover:text-[var(--color-liquid-primary)] transition-colors">Core Concepts</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--color-ink-muted)]">Project</h3>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={repo} target="_blank" rel="noopener noreferrer" class="text-[var(--color-ink)] hover:text-[var(--color-liquid-primary)] transition-colors">GitHub repo</a></li>
        <li><a href="https://www.npmjs.com/package/liquiddom" target="_blank" rel="noopener noreferrer" class="text-[var(--color-ink)] hover:text-[var(--color-liquid-primary)] transition-colors">npm: liquiddom</a></li>
        <li><a href="https://www.npmjs.com/package/@liquiddom/react" target="_blank" rel="noopener noreferrer" class="text-[var(--color-ink)] hover:text-[var(--color-liquid-primary)] transition-colors">npm: @liquiddom/react</a></li>
        <li><a href="https://www.npmjs.com/package/@liquiddom/vue" target="_blank" rel="noopener noreferrer" class="text-[var(--color-ink)] hover:text-[var(--color-liquid-primary)] transition-colors">npm: @liquiddom/vue</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-[var(--color-border)]">
    <div class="container-page py-4 text-xs text-[var(--color-ink-muted)] flex flex-col md:flex-row justify-between gap-2">
      <span>MIT &copy; Dennis Schmock</span>
      <span>Built with <a href="https://astro.build" class="underline hover:text-[var(--color-ink)]" target="_blank" rel="noopener noreferrer">Astro</a> and <a href={repo} class="underline hover:text-[var(--color-ink)]" target="_blank" rel="noopener noreferrer">liquiddom</a></span>
    </div>
  </div>
</footer>
