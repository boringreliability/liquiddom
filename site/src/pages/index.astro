---
import BaseLayout from "../layouts/BaseLayout.astro";
import LiveHero from "../components/LiveHero.astro";
// TryItNow import removed in W60 r3 — see commented-out section + W61 spec.
// Re-add when the multi-instance bug is fixed.

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="liquiddom — Physical DOM, real accessibility">
  <!-- ── Hero (live LiquidDOM background, W60) ────────────────────── -->
  <section class="relative overflow-hidden">
    <LiveHero />

    <div class="container-page py-20 md:py-32 text-center relative z-10">
      <span class="pill mb-6">
        v0.2.0-rc.0 · MIT
      </span>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-[var(--color-ink)] max-w-4xl mx-auto leading-tight">
        Physical DOM, <span class="bg-gradient-to-r from-[var(--color-liquid-primary)] to-[var(--color-liquid-accent)] bg-clip-text text-transparent">without sacrificing accessibility</span>
      </h1>
      <p class="mt-6 text-lg md:text-xl text-[var(--color-ink-muted)] max-w-2xl mx-auto">
        WASM-driven soft-body physics animates your real DOM elements through
        a hidden canvas overlay. Screen readers, keyboard focus, and
        <code class="font-mono text-sm">:hover</code> all just work.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={`${base}docs/getting-started/`}
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[var(--color-liquid-primary)] text-white font-semibold shadow-lg shadow-[var(--color-liquid-primary)]/30 hover:bg-[var(--color-liquid-deep)] transition-colors"
        >
          Get started →
        </a>
        <a
          href="https://github.com/boringreliability/liquiddom"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[var(--color-surface-muted)] text-[var(--color-ink)] font-semibold border border-[var(--color-border)] hover:bg-[var(--color-surface-strong)] transition-colors"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.92.58.11.79-.25.79-.56v-2.02c-3.2.7-3.87-1.37-3.87-1.37-.52-1.34-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.71 1.25 3.37.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z" />
          </svg>
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- ── Features ───────────────────────────────────────────────── -->
  <section class="container-page py-16 md:py-24">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-[var(--color-ink)]">
      Built for production
    </h2>
    <p class="mt-3 text-center text-[var(--color-ink-muted)] max-w-2xl mx-auto">
      A vanilla web library. Zero framework lock-in. Pre-allocated buffer pool.
      Zero per-frame allocation in the hot path.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <article class="p-6 rounded-2xl bg-[var(--color-surface-muted)] border border-[var(--color-border)]">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--color-liquid-primary)]/10 text-[var(--color-liquid-primary)] mb-4">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-[var(--color-ink)]">Real DOM, real a11y</h3>
        <p class="mt-2 text-sm text-[var(--color-ink-muted)] leading-relaxed">
          Your <code class="font-mono text-xs">&lt;button&gt;</code> stays a
          <code class="font-mono text-xs">&lt;button&gt;</code>. Screen readers
          see it, keyboard focus works, <code class="font-mono text-xs">:hover</code>
          fires. liquiddom paints over — never replaces.
        </p>
      </article>

      <article class="p-6 rounded-2xl bg-[var(--color-surface-muted)] border border-[var(--color-border)]">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--color-liquid-accent)]/10 text-[var(--color-liquid-accent)] mb-4">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 18 6-6-6-6" />
            <path d="m3 12h18" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-[var(--color-ink)]">WebGPU when available</h3>
        <p class="mt-2 text-sm text-[var(--color-ink-muted)] leading-relaxed">
          <code class="font-mono text-xs">renderer: 'auto'</code> probes
          WebGPU then falls back to Canvas2D transparently. Metaball fusion
          and background refraction on capable browsers.
        </p>
      </article>

      <article class="p-6 rounded-2xl bg-[var(--color-surface-muted)] border border-[var(--color-border)]">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--color-liquid-deep)]/10 text-[var(--color-liquid-deep)] mb-4">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2L2 7l10 5 10-5-10-5z" />
            <path d="m2 17 10 5 10-5" />
            <path d="m2 12 10 5 10-5" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-[var(--color-ink)]">Framework adapters</h3>
        <p class="mt-2 text-sm text-[var(--color-ink-muted)] leading-relaxed">
          Vanilla TS, React 18+, Vue 3.4+. One WASM instance shared across the
          app, idiomatic adapters that respect strict mode and SSR.
        </p>
      </article>
    </div>
  </section>

  <!-- ── Try it now (live squish widget, W60) ─────────────────────── -->
  <!-- TEMPORARILY DISABLED: two simultaneous LiquidDOM instances on landing
       (LiveHero + TryItNow) trigger a wasm-bindgen "recursive use of object"
       panic from the Rust core. Investigation deferred to follow-up ward. -->
  <!-- <TryItNow /> -->

  <!-- ── Install ────────────────────────────────────────────────── -->
  <section class="container-page py-16 md:py-24">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-[var(--color-ink)]">
        Install in 30 seconds
      </h2>
      <p class="mt-3 text-center text-[var(--color-ink-muted)]">
        Published on npm as MIT. Vanilla core + optional framework adapters.
      </p>

      <div class="mt-10" data-install-tabs>
        <div role="tablist" aria-label="Package manager" class="inline-flex rounded-full border border-[var(--color-border)] bg-[var(--color-surface-muted)] p-1 text-sm">
          <button role="tab" data-tab="npm" aria-selected="true" tabindex="0" class="rounded-full px-4 py-1 font-medium cursor-pointer aria-selected:bg-[var(--color-liquid-primary)] aria-selected:text-white text-[var(--color-ink-muted)] transition-colors">npm</button>
          <button role="tab" data-tab="pnpm" aria-selected="false" tabindex="-1" class="rounded-full px-4 py-1 font-medium cursor-pointer aria-selected:bg-[var(--color-liquid-primary)] aria-selected:text-white text-[var(--color-ink-muted)] transition-colors">pnpm</button>
          <button role="tab" data-tab="yarn" aria-selected="false" tabindex="-1" class="rounded-full px-4 py-1 font-medium cursor-pointer aria-selected:bg-[var(--color-liquid-primary)] aria-selected:text-white text-[var(--color-ink-muted)] transition-colors">yarn</button>
        </div>

        <div class="mt-4 rounded-xl bg-[var(--color-ink)] text-[var(--color-surface)] p-5 font-mono text-sm overflow-x-auto">
          <pre data-tab-panel="npm"><code>npm install liquiddom @liquiddom/react @liquiddom/vue</code></pre>
          <pre data-tab-panel="pnpm" hidden><code>pnpm add liquiddom @liquiddom/react @liquiddom/vue</code></pre>
          <pre data-tab-panel="yarn" hidden><code>yarn add liquiddom @liquiddom/react @liquiddom/vue</code></pre>
        </div>

        <p class="mt-3 text-xs text-[var(--color-ink-muted)] text-center">
          The React and Vue adapters are optional. Install only what your app uses.
        </p>
      </div>
    </div>
  </section>

  <script>
    // Install-snippet tabs — vanilla TS, no framework.
    // Implements WAI-ARIA tablist pattern: click + arrow-key nav.
    const containers = document.querySelectorAll<HTMLElement>('[data-install-tabs]');
    for (const root of Array.from(containers)) {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('button[role="tab"]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-tab-panel]'));

      function activate(name: string, focus = false) {
        for (const tab of tabs) {
          const active = tab.dataset.tab === name;
          tab.setAttribute("aria-selected", active ? "true" : "false");
          tab.tabIndex = active ? 0 : -1;
          if (active && focus) tab.focus();
        }
        for (const panel of panels) {
          panel.hidden = panel.dataset.tabPanel !== name;
        }
      }

      for (const tab of tabs) {
        tab.addEventListener("click", () => activate(tab.dataset.tab!));
      }

      // Arrow / Home / End keyboard nav per WAI-ARIA tablist pattern
      root.addEventListener("keydown", (e: KeyboardEvent) => {
        const tablist = (e.target as HTMLElement).closest('[role="tablist"]');
        if (!tablist) return;
        const currentIdx = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
        let nextIdx = currentIdx;
        switch (e.key) {
          case "ArrowRight": case "ArrowDown":
            nextIdx = (currentIdx + 1) % tabs.length; break;
          case "ArrowLeft": case "ArrowUp":
            nextIdx = (currentIdx - 1 + tabs.length) % tabs.length; break;
          case "Home": nextIdx = 0; break;
          case "End": nextIdx = tabs.length - 1; break;
          default: return;
        }
        e.preventDefault();
        const next = tabs[nextIdx];
        if (next) activate(next.dataset.tab!, true);
      });
    }
  </script>
</BaseLayout>
