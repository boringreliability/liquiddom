---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Documentation — liquiddom" description="Documentation for liquiddom: getting started, core concepts, and reference.">
  <div class="container-page py-16 md:py-20">
    <span class="pill mb-3">Documentation</span>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-[var(--color-ink)]">
      Documentation
    </h1>
    <p class="mt-4 text-lg text-[var(--color-ink-muted)] max-w-2xl">
      Everything you need to start animating real DOM elements with physical
      soft-body dynamics. The library is small (~8KB gzipped + ~15KB WASM)
      and framework-agnostic.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <a
        href={`${base}docs/getting-started/`}
        class="group block p-8 rounded-2xl bg-[var(--color-surface-muted)] border border-[var(--color-border)] hover:border-[var(--color-liquid-primary)] hover:shadow-lg transition-all"
      >
        <h2 class="text-2xl font-semibold text-[var(--color-ink)] flex items-center gap-2">
          Getting Started
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-[var(--color-ink-muted)] group-hover:translate-x-1 group-hover:text-[var(--color-liquid-primary)] transition-all">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </h2>
        <p class="mt-3 text-[var(--color-ink-muted)]">
          Install the package, create your first instance, and turn any element
          into a physical soft-body in under a minute.
        </p>
      </a>

      <a
        href={`${base}docs/core-concepts/`}
        class="group block p-8 rounded-2xl bg-[var(--color-surface-muted)] border border-[var(--color-border)] hover:border-[var(--color-liquid-primary)] hover:shadow-lg transition-all"
      >
        <h2 class="text-2xl font-semibold text-[var(--color-ink)] flex items-center gap-2">
          Core Concepts
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-[var(--color-ink-muted)] group-hover:translate-x-1 group-hover:text-[var(--color-liquid-primary)] transition-all">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </h2>
        <p class="mt-3 text-[var(--color-ink-muted)]">
          The Rule of Two, the flat-buffer FFI contract, the per-frame loop
          order, and the liquid_type dispatch architecture.
        </p>
      </a>
    </div>

    <aside class="mt-16 p-6 rounded-2xl bg-[var(--color-liquid-primary)]/5 border border-[var(--color-liquid-primary)]/20">
      <h3 class="text-base font-semibold text-[var(--color-ink)]">
        Showcases coming in v0.2.1
      </h3>
      <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
        Interactive demos with code snippets and explanations land in the
        next ward (W59). For now, the API surface and the architecture pages
        cover everything you need to build with the library today.
      </p>
    </aside>
  </div>
</BaseLayout>
