{
  "name": "liquiddom-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build:ts": "npm run build --workspaces --if-present",
    "build": "npm run build:wasm && npm run build:ts",
    "test": "vitest run",
    "test:rust": "cargo test",
    "clippy": "cargo clippy --all-targets --all-features -- -D warnings",
    "verify": "npm run build && npm run test:rust && npm run test && npm run clippy",
    "dev": "npm run build:wasm && vite --config demo/vite.config.ts demo",
    "e2e": "playwright test",
    "e2e:canvas2d": "playwright test --project=canvas2d",
    "e2e:webgpu": "playwright test --project=webgpu",
    "e2e:perf": "playwright test --project=perf",
    "e2e:update": "bash scripts/e2e-docker.sh --project=canvas2d --update-snapshots=all",
    "e2e:docker": "bash scripts/e2e-docker.sh",
    "e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json",
    "e2e:dist:build": "npm run build -w liquiddom && npm run build -w @liquiddom/react && npm run build -w liquiddom-react-example --ignore-scripts",
    "e2e:dist": "npm run e2e:dist:build && playwright test --project=dist",
    "whole-picture": "playwright test e2e/record.spec.ts --project=record && node scripts/webm-to-gif.mjs test-results/whole-picture/manifest.json docs/superpowers/whole-picture/slice-2-canvas2d.gif",
    "bench:opt-level": "node scripts/bench-opt-level.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && npx changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "^2.27.0",
    "@changesets/get-release-plan": "^4.0.16",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "^7.7.1",
    "@vue/server-renderer": "^3.5.34",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.0",
    "tweakpane": "^4.0.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "vue": "^3.5.34",
    "yaml": "^2.9.1"
  }
}
