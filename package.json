{
  "name": "liquiddom-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build:ts": "npm run build --workspaces --if-present",
    "build": "npm run build:wasm && npm run build:ts",
    "test": "vitest run",
    "test:rust": "cargo test",
    "clippy": "cargo clippy --all-targets --all-features -- -D warnings",
    "verify": "npm run build && npm run test:rust && npm run test && npm run clippy",
    "dev": "npm run build:wasm && vite --config demo/vite.config.ts demo",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && npx changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "^7.7.1",
    "@vue/server-renderer": "^3.5.34",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.0",
    "tweakpane": "^4.0.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "vue": "^3.5.34"
  }
}
