{
  "name": "liquiddom",
  "version": "0.1.0",
  "description": "WASM-driven fluid dynamics on web elements via hidden canvas",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:copy-wasm": "node scripts/copy-wasm.mjs",
    "build": "npm run build:wasm && npm run build:ts && npm run build:copy-wasm",
    "prepublishOnly": "npm run build",
    "dev": "npm run build:wasm && vite --config demo/vite.config.ts demo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "physics",
    "canvas",
    "liquid",
    "animation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vue/server-renderer": "^3.5.34",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tweakpane": "^4.0.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "vue": "^3.5.34"
  }
}
