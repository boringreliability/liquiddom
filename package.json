{
  "name": "liquiddom",
  "version": "0.1.0",
  "description": "WASM-driven fluid dynamics on web elements via hidden canvas",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:copy-wasm": "node scripts/copy-wasm.mjs",
    "build": "npm run build:wasm && npm run build:ts && npm run build:copy-wasm",
    "prepublishOnly": "npm run build",
    "dev": "npm run build:wasm && vite --config demo/vite.config.ts demo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["wasm", "webassembly", "physics", "canvas", "liquid", "animation"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "jsdom": "^29.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
