{
  "name": "@liquiddom/vue",
  "version": "0.2.0-rc.0",
  "description": "Vue 3 bindings for liquiddom",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "liquiddom": "^0.2.0-rc.0",
    "vue": "^3.4.0"
  },
  "author": "Dennis Schmock",
  "license": "MIT",
  "homepage": "https://github.com/boringreliability/liquiddom/tree/master/packages/vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boringreliability/liquiddom.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/boringreliability/liquiddom/issues"
  },
  "keywords": [
    "liquiddom",
    "vue",
    "vue3",
    "wasm",
    "physics",
    "animation"
  ],
  "publishConfig": {
    "access": "public"
  }
