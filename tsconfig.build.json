{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "ts/src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false
  },
  "include": ["ts/src/**/*"],
  "exclude": ["ts/__tests__/**/*"]
}
